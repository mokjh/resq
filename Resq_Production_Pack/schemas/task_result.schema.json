{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resq bounded task result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "commit",
    "summary",
    "artifacts",
    "tests",
    "evidence_level",
    "limitations",
    "blockers",
    "cost_usd",
    "next_task_ids"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "skipped_with_reason"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence_path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "evidence_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "evidence_level": {
      "enum": [
        "specification_only",
        "automated",
        "device",
        "human_observed",
        "mixed",
        "none"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "next_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1
          },
          "tests": {
            "minItems": 1
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
