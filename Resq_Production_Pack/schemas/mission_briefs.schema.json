{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resq authored mission briefs (not runtime levels)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "world_id",
      "order",
      "title",
      "status",
      "release_scope",
      "duration_seconds",
      "total_residents",
      "minimum_rescues",
      "supply_budget",
      "default_loadout",
      "core_decision",
      "layout_brief",
      "event_briefs",
      "required_objectives_brief",
      "mastery_brief",
      "reference_plan_a",
      "reference_plan_b",
      "failure_explanation",
      "signature_moment",
      "required_evidence",
      "input_presets"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^W[1-5]-M[1-5]$"
      },
      "world_id": {
        "type": "string",
        "pattern": "^W[1-5]$"
      },
      "order": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "const": "authored_brief_unimplemented"
      },
      "release_scope": {
        "enum": [
          "competition",
          "full_release"
        ]
      },
      "duration_seconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 600
      },
      "total_residents": {
        "type": "integer",
        "minimum": 1
      },
      "minimum_rescues": {
        "type": "integer",
        "minimum": 1
      },
      "supply_budget": {
        "type": "integer",
        "minimum": 1
      },
      "default_loadout": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "integer",
          "minimum": 1
        }
      },
      "core_decision": {
        "type": "string",
        "minLength": 1
      },
      "layout_brief": {
        "type": "string",
        "minLength": 1
      },
      "event_briefs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "simulation_second",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "simulation_second": {
              "type": "integer",
              "minimum": 0
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required_objectives_brief": {
        "type": "string",
        "minLength": 1
      },
      "mastery_brief": {
        "type": "string",
        "minLength": 1
      },
      "reference_plan_a": {
        "type": "string",
        "minLength": 1
      },
      "reference_plan_b": {
        "type": "string",
        "minLength": 1
      },
      "failure_explanation": {
        "type": "string",
        "minLength": 1
      },
      "signature_moment": {
        "type": "string",
        "minLength": 1
      },
      "required_evidence": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "input_presets": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "standard_hands",
            "relaxed_hands",
            "command_head_dwell"
          ]
        }
      }
    }
  }
}
