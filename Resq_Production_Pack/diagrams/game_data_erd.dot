digraph ResqERD {
graph [rankdir=LR, bgcolor="transparent", pad="0.3", nodesep="0.35", ranksep="1.1", fontname="Arial"];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=9,color="#66807a",arrowsize=0.6];
