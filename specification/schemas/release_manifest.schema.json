{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": [
        "candidate",
        "qualified",
        "released"
      ]
    },
    "scope": {
      "enum": [
        "world",
        "competition",
        "full"
      ]
    },
    "edition": {
      "enum": [
        "game_only",
        "delivery_bundle"
      ]
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "platform_version_code": {
      "type": "integer",
      "minimum": 1
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_snapshot": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "kind",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "toolchain_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "apk": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "kind",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "signing_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implemented_missions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "qualified_missions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "qualified_devices": {
      "type": "array",
      "items": {
        "enum": [
          "quest3",
          "quest3s"
        ]
      },
      "minItems": 0
    },
    "verified_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "kind",
          "byte_length"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "qualification_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "result_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "task_id",
          "result_path",
          "result_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "capture_compatibility": {
      "type": "object",
      "properties": {
        "build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rules_version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "build_sha256",
        "rules_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "publication_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "kind",
          "byte_length"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "status",
    "scope",
    "edition",
    "semantic_version",
    "platform_version_code",
    "source_commit",
    "source_snapshot",
    "rules_version",
    "toolchain_hash",
    "content_hash",
    "asset_manifest_hash",
    "apk",
    "signing_certificate_sha256",
    "implemented_missions",
    "qualified_missions",
    "qualified_devices",
    "verified_features",
    "evidence",
    "qualification_tasks",
    "known_limitations",
    "open_issues",
    "capture_compatibility",
    "publication_records"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "qualified",
              "released"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "qualified_missions": {
            "minItems": 5
          },
          "qualified_devices": {
            "minItems": 2,
            "uniqueItems": true
          },
          "open_issues": {
            "items": {
              "properties": {
                "severity": {
                  "enum": [
                    "P3"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "publication_records": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
