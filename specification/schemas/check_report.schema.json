{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "evidence_kind": {
      "enum": [
        "automated",
        "physical_device",
        "human_observation",
        "human_signoff",
        "external_verified"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "freeze_id": {
          "const": "resq-spec-freeze-1.1.0"
        },
        "rules_version": {
          "const": "resq-rules-1"
        },
        "source_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "kind",
            "byte_length"
          ],
          "additionalProperties": false
        },
        "content_manifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "kind",
            "byte_length"
          ],
          "additionalProperties": false
        },
        "toolchain_lock": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "kind",
            "byte_length"
          ],
          "additionalProperties": false
        },
        "git_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "build_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "freeze_id",
        "rules_version",
        "source_identity",
        "content_hash",
        "toolchain_hash",
        "source_manifest",
        "content_manifest",
        "toolchain_lock",
        "git_head",
        "dirty",
        "build_sha256"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        ]
      }
    },
    "execution_context": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "started_utc": {
          "type": "string",
          "minLength": 1
        },
        "finished_utc": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "stdout": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "kind",
            "byte_length"
          ],
          "additionalProperties": false
        },
        "stderr": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "kind",
            "byte_length"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "task_id",
        "started_utc",
        "finished_utc",
        "actor",
        "cwd",
        "stdout",
        "stderr"
      ],
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "native_report": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "byte_length": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "path",
                "sha256",
                "kind",
                "byte_length"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "executed_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_skipped_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "executed",
        "exit_code",
        "native_report",
        "executed_count",
        "failed_count",
        "required_skipped_count"
      ],
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "status",
          "evidence_path",
          "evidence_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "case_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run",
              "skipped"
            ]
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "participant_alias": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "proof_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "kind",
              "byte_length"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "case_id",
          "kind",
          "status",
          "dimensions",
          "metrics",
          "participant_alias",
          "proof_index",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "kind",
          "byte_length"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "proof_records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "record_type": {
                "const": "physical_device"
              },
              "model": {
                "enum": [
                  "quest3",
                  "quest3s"
                ]
              },
              "os_version": {
                "type": "string",
                "minLength": 1
              },
              "local_device_alias": {
                "type": "string",
                "minLength": 1
              },
              "build_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "capture_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "capture_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observed_utc": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "record_type",
              "model",
              "os_version",
              "local_device_alias",
              "build_sha256",
              "session_id",
              "capture_path",
              "capture_sha256",
              "observed_utc"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "record_type": {
                "const": "human_observation"
              },
              "observer_kind": {
                "const": "human"
              },
              "observer_alias": {
                "type": "string",
                "minLength": 1
              },
              "participant_alias": {
                "type": "string",
                "minLength": 1
              },
              "consent_record_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "consent_record_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "build_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observations_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "observations_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observed_utc": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "record_type",
              "observer_kind",
              "observer_alias",
              "participant_alias",
              "consent_record_path",
              "consent_record_sha256",
              "build_sha256",
              "observations_path",
              "observations_sha256",
              "observed_utc"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "record_type": {
                "const": "human_signoff"
              },
              "reviewer_kind": {
                "const": "human"
              },
              "reviewer_alias": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_artifact_hashes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "minItems": 1
              },
              "decision": {
                "const": "accepted"
              },
              "review_record_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "review_record_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "signed_utc": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "record_type",
              "reviewer_kind",
              "reviewer_alias",
              "reviewed_artifact_hashes",
              "decision",
              "review_record_path",
              "review_record_sha256",
              "signed_utc"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "record_type": {
                "const": "external_verified"
              },
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "resource_id": {
                "type": "string",
                "minLength": 1
              },
              "verified_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "authorization_record_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "authorization_record_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "verification_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "verification_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "record_type",
              "destination",
              "resource_id",
              "verified_url",
              "authorization_record_path",
              "authorization_record_sha256",
              "verification_path",
              "verification_sha256"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "check_id",
    "status",
    "exit_code",
    "evidence_kind",
    "identity",
    "command",
    "coverage",
    "execution_context",
    "runner",
    "assertions",
    "case_records",
    "artifacts",
    "proof_records",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "runner": {
            "properties": {
              "executed": {
                "const": true
              },
              "exit_code": {
                "const": 0
              },
              "native_report": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "byte_length": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "kind",
                  "byte_length"
                ],
                "additionalProperties": false
              },
              "executed_count": {
                "minimum": 1
              },
              "failed_count": {
                "const": 0
              },
              "required_skipped_count": {
                "const": 0
              }
            }
          },
          "case_records": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          },
          "assertions": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          }
        }
      }
    }
  ]
}
